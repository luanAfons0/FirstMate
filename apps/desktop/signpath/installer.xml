<?xml version="1.0" encoding="utf-8"?>
<!--
  The artifact configuration "installer" in SignPath: the NSIS installer the
  release workflow builds from the signed App, in a zip of its own (ADR-0027).
  SignPath reads its own copy; this file is the one it is pasted from.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="FirstMate-Setup-*.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
