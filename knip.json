{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["tests/**/*.ts"]
    },
    "apps/cli": {
      "project": ["src/**/*.ts"]
    },
    "apps/desktop": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"]
    },
    "packages/host": {
      "project": ["src/**/*.ts"]
    }
  }
}
