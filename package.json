{
  "name": "firstmate",
  "version": "2.0.0-beta.2",
  "private": true,
  "description": "The FirstMate workspace. The published package is apps/cli.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node packages/host/src/main.ts",
    "build": "pnpm --filter @luan-afonso/firstmate build",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.0.0",
    "knip": "^6.38.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.0"
  },
  "packageManager": "pnpm@12.9.1"
}
