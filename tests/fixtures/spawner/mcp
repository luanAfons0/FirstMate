#!/usr/bin/env node
// A fixture Plugin Server that starts one child, which sleeps, so that its
// Plugin counts two processes. The child ends with its parent: when the
// Plugin Server ends, the child sees it has a new parent and goes too.
import { spawn } from 'node:child_process';
import { createInterface } from 'node:readline';

const sleeper =
  'setInterval(() => { if (process.ppid !== Number(process.argv[1])) process.exit(); }, 200);';
const child = spawn(process.execPath, ['-e', sleeper, String(process.pid)], { stdio: 'ignore' });

const reply = (message) => process.stdout.write(`${JSON.stringify(message)}\n`);

for await (const line of createInterface({ input: process.stdin })) {
  if (line.trim() === '') continue;
  const request = JSON.parse(line);
  if (request.id === undefined || request.id === null) continue;
  if (request.method === 'initialize') {
    reply({
      jsonrpc: '2.0',
      id: request.id,
      result: {
        protocolVersion: '2025-06-18',
        capabilities: { tools: {} },
        serverInfo: { name: 'spawner', version: '1.0.0' },
      },
    });
    continue;
  }
  reply({
    jsonrpc: '2.0',
    id: request.id,
    error: { code: -32601, message: `no such method: ${request.method}` },
  });
}
// stdin closed: the Host asks this Plugin Server to end, and its child with it.
child.kill();
